<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/white"
            android:elevation="6dp"
            app:title="Budget Management"
            app:titleCentered="true"
            app:titleTextColor="#212121"
            app:navigationIcon="@drawable/ic_back_arrow"
            app:navigationIconTint="#212121"/>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">

                <!-- Monthly Budget Summary -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="8dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E6EAF2"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Monthly Budget"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#212121"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Monitor your monthly spending"
                            android:textSize="13sp"
                            android:textColor="#757575"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="18dp"
                            android:layout_marginBottom="18dp"
                            android:background="#EEEEEE"/>

                        <TextView
                            android:id="@+id/tvMonthlyBudget"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Budget : Rs. 0.00"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#1565C0"/>

                        <TextView
                            android:id="@+id/tvSpentAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Spent : Rs. 0.00"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#E53935"/>

                        <TextView
                            android:id="@+id/tvRemainingAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Remaining : Rs. 0.00"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#2E7D32"/>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressBudget"
                            android:layout_width="match_parent"
                            android:layout_height="10dp"
                            android:layout_marginTop="24dp"
                            android:max="100"
                            app:trackThickness="10dp"
                            app:trackCornerRadius="6dp"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:background="#EAEAEA"/>

                <!-- Category Budget Card -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="8dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E6EAF2"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Category Budget Allocation"
                            android:textStyle="bold"
                            android:textSize="20sp"
                            android:textColor="#212121"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="20dp"
                            android:text="Set spending limits for each category"
                            android:textColor="#757575"
                            android:textSize="13sp"/>

                        <!-- Monthly Budget -->

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="14dp"

                            android:hint="Monthly Budget"

                            app:boxCornerRadiusTopStart="18dp"
                            app:boxCornerRadiusTopEnd="18dp"
                            app:boxCornerRadiusBottomStart="18dp"
                            app:boxCornerRadiusBottomEnd="18dp"

                            app:boxStrokeColor="#1565C0"

                            app:hintTextColor="#616161">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etMonthlyBudget"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:inputType="numberDecimal"

                                android:textSize="16sp"

                                android:textColor="#212121"

                                android:textColorHint="#9E9E9E"

                                android:paddingTop="16dp"
                                android:paddingBottom="16dp"/>

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Food -->

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="14dp"

                            android:hint="Food Budget"

                            app:boxCornerRadiusTopStart="18dp"
                            app:boxCornerRadiusTopEnd="18dp"
                            app:boxCornerRadiusBottomStart="18dp"
                            app:boxCornerRadiusBottomEnd="18dp"

                            app:boxStrokeColor="#1565C0"

                            app:hintTextColor="#616161">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etFoodBudget"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:inputType="numberDecimal"

                                android:textSize="16sp"

                                android:textColor="#212121"

                                android:textColorHint="#9E9E9E"

                                android:paddingTop="16dp"
                                android:paddingBottom="16dp"/>

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Transport -->

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="14dp"

                            android:hint="Transport Budget"

                            app:boxCornerRadiusTopStart="18dp"
                            app:boxCornerRadiusTopEnd="18dp"
                            app:boxCornerRadiusBottomStart="18dp"
                            app:boxCornerRadiusBottomEnd="18dp"

                            app:boxStrokeColor="#1565C0"

                            app:hintTextColor="#616161">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTransportBudget"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:inputType="numberDecimal"

                                android:textSize="16sp"

                                android:textColor="#212121"

                                android:textColorHint="#9E9E9E"

                                android:paddingTop="16dp"
                                android:paddingBottom="16dp"/>

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Shopping -->

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="14dp"

                            android:hint="Shopping Budget"

                            app:boxCornerRadiusTopStart="18dp"
                            app:boxCornerRadiusTopEnd="18dp"
                            app:boxCornerRadiusBottomStart="18dp"
                            app:boxCornerRadiusBottomEnd="18dp"

                            app:boxStrokeColor="#1565C0"

                            app:hintTextColor="#616161">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etShoppingBudget"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:inputType="numberDecimal"

                                android:textSize="16sp"

                                android:textColor="#212121"

                                android:textColorHint="#9E9E9E"

                                android:paddingTop="16dp"
                                android:paddingBottom="16dp"/>

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Bills -->

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="14dp"

                            android:hint="Bills Budget"

                            app:boxCornerRadiusTopStart="18dp"
                            app:boxCornerRadiusTopEnd="18dp"
                            app:boxCornerRadiusBottomStart="18dp"
                            app:boxCornerRadiusBottomEnd="18dp"

                            app:boxStrokeColor="#1565C0"

                            app:hintTextColor="#616161">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etBillsBudget"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:inputType="numberDecimal"

                                android:textSize="16sp"

                                android:textColor="#212121"

                                android:textColorHint="#9E9E9E"

                                android:paddingTop="16dp"
                                android:paddingBottom="16dp"/>

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Health -->

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="14dp"

                            android:hint="Health Budget"

                            app:boxCornerRadiusTopStart="18dp"
                            app:boxCornerRadiusTopEnd="18dp"
                            app:boxCornerRadiusBottomStart="18dp"
                            app:boxCornerRadiusBottomEnd="18dp"

                            app:boxStrokeColor="#1565C0"

                            app:hintTextColor="#616161">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etHealthBudget"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:inputType="numberDecimal"

                                android:textSize="16sp"

                                android:textColor="#212121"

                                android:textColorHint="#9E9E9E"

                                android:paddingTop="16dp"
                                android:paddingBottom="16dp"/>

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Education -->

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="14dp"

                            android:hint="Eductaion Budget"

                            app:boxCornerRadiusTopStart="18dp"
                            app:boxCornerRadiusTopEnd="18dp"
                            app:boxCornerRadiusBottomStart="18dp"
                            app:boxCornerRadiusBottomEnd="18dp"

                            app:boxStrokeColor="#1565C0"

                            app:hintTextColor="#616161">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEducationBudget"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:inputType="numberDecimal"

                                android:textSize="16sp"

                                android:textColor="#212121"

                                android:textColorHint="#9E9E9E"

                                android:paddingTop="16dp"
                                android:paddingBottom="16dp"/>

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Entertainment -->

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="14dp"

                            android:hint="Entertainment Budget"

                            app:boxCornerRadiusTopStart="18dp"
                            app:boxCornerRadiusTopEnd="18dp"
                            app:boxCornerRadiusBottomStart="18dp"
                            app:boxCornerRadiusBottomEnd="18dp"

                            app:boxStrokeColor="#1565C0"

                            app:hintTextColor="#616161">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEntertainmentBudget"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:inputType="numberDecimal"

                                android:textSize="16sp"

                                android:textColor="#212121"

                                android:textColorHint="#9E9E9E"

                                android:paddingTop="16dp"
                                android:paddingBottom="16dp"/>

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Others -->

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="14dp"

                            android:hint="Others Budget"

                            app:boxCornerRadiusTopStart="18dp"
                            app:boxCornerRadiusTopEnd="18dp"
                            app:boxCornerRadiusBottomStart="18dp"
                            app:boxCornerRadiusBottomEnd="18dp"

                            app:boxStrokeColor="#1565C0"

                            app:hintTextColor="#616161">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etOthersBudget"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:inputType="numberDecimal"

                                android:textSize="16sp"

                                android:textColor="#212121"

                                android:textColorHint="#9E9E9E"

                                android:paddingTop="16dp"
                                android:paddingBottom="16dp"/>

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Save Button -->

                <!-- Save Button -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveBudget"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp"

                    android:text="Save Budget"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="16sp"

                    android:elevation="4dp"

                    app:cornerRadius="18dp"

                    app:icon="@drawable/ic_save"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"

                    app:backgroundTint="#1565C0"
                    android:textColor="@android:color/white"/>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <!-- Loading -->

    <!-- Loading -->

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressIndicator"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:visibility="gone"

        app:indicatorSize="64dp"
        app:indicatorInset="8dp"
        app:trackThickness="6dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>