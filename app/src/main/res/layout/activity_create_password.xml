<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- ========================================================= -->
    <!-- MAIN SCROLL VIEW                                          -->
    <!-- ========================================================= -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewCreatePassword"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="18dp"
            android:paddingBottom="32dp">


            <!-- ================================================= -->
            <!-- TOP BAR                                           -->
            <!-- ================================================= -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="48dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="10dp"
                    android:src="@drawable/ic_back_arrow"
                    android:contentDescription="Back"
                    app:tint="#111827"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create Account"
                    android:textColor="#111827"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <!-- ================================================= -->
            <!-- PROGRESS INDICATOR                                -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:background="#22C55E" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:background="@android:color/transparent" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:background="#22C55E" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:background="@android:color/transparent" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:background="#22C55E" />

            </LinearLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="7dp"
                android:text="STEP 3 OF 3"
                android:textColor="#16A34A"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />


            <!-- ================================================= -->
            <!-- BRAND / LOGO                                      -->
            <!-- ================================================= -->

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:src="@drawable/main_logo"
                android:scaleType="centerInside"
                android:contentDescription="ExpenseVault Logo" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="7dp"
                android:text="ExpenseVault"
                android:textColor="#111827"
                android:textSize="19sp"
                android:textStyle="bold" />


            <!-- ================================================= -->
            <!-- TITLE                                             -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Create a secure password"
                android:textColor="#111827"
                android:textSize="26sp"
                android:textStyle="bold" />


            <!-- DESCRIPTION -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:lineSpacingExtra="3dp"
                android:text="Choose a strong password to protect your financial information and ExpenseVault account."
                android:textColor="#64748B"
                android:textSize="14sp" />


            <!-- ================================================= -->
            <!-- PASSWORD FORM CARD                                -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">


                    <!-- PASSWORD -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="PASSWORD"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />


                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/passwordInputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:boxBackgroundColor="#F8FAFC"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="#22C55E"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#64748B"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="#94A3B8">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:background="@null"
                            android:hint="Enter password"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:paddingStart="44dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:textColor="#111827"
                            android:textColorHint="#94A3B8"
                            android:textSize="14sp" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- CONFIRM PASSWORD -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="CONFIRM PASSWORD"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />


                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/confirmPasswordInputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:boxBackgroundColor="#F8FAFC"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="#22C55E"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#64748B"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="#94A3B8">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:background="@null"
                            android:hint="Re-enter password"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:paddingStart="44dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:textColor="#111827"
                            android:textColorHint="#94A3B8"
                            android:textSize="14sp" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- ================================================= -->
                    <!-- PASSWORD REQUIREMENTS                         -->
                    <!-- ================================================= -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPasswordRequirements"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        app:cardBackgroundColor="#F8FAFC"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#E2E8F0"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="PASSWORD REQUIREMENTS"
                                android:textColor="#64748B"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.06" />


                            <!-- Requirement 1 -->

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="13dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/checkMinCharacters"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:background="@drawable/resource_true"
                                    android:gravity="center"
                                    android:text="✓"
                                    android:textColor="#94A3B8"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvMinCharacters"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="9dp"
                                    android:text="At least 8 characters"
                                    android:textColor="#64748B"
                                    android:textSize="12sp" />

                            </LinearLayout>


                            <!-- Requirement 2 -->

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="9dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/checkUppercase"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:background="@drawable/resource_true"
                                    android:gravity="center"
                                    android:text="✓"
                                    android:textColor="#94A3B8"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvUppercase"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="9dp"
                                    android:text="One uppercase letter"
                                    android:textColor="#64748B"
                                    android:textSize="12sp" />

                            </LinearLayout>


                            <!-- Requirement 3 -->

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="9dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/checkLowercase"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:background="@drawable/resource_true"
                                    android:gravity="center"
                                    android:text="✓"
                                    android:textColor="#94A3B8"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvLowercase"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="9dp"
                                    android:text="One lowercase letter"
                                    android:textColor="#64748B"
                                    android:textSize="12sp" />

                            </LinearLayout>


                            <!-- Requirement 4 -->

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="9dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/checkNumber"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:background="@drawable/resource_true"
                                    android:gravity="center"
                                    android:text="✓"
                                    android:textColor="#94A3B8"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvNumber"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="9dp"
                                    android:text="One number"
                                    android:textColor="#64748B"
                                    android:textSize="12sp" />

                            </LinearLayout>


                            <!-- Requirement 5 -->

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="9dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/checkSpecialCharacter"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:background="@drawable/resource_true"
                                    android:gravity="center"
                                    android:text="✓"
                                    android:textColor="#94A3B8"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvSpecialCharacter"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="9dp"
                                    android:text="One special character"
                                    android:textColor="#64748B"
                                    android:textSize="12sp" />

                            </LinearLayout>


                            <!-- Requirement 6 -->

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="9dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/checkPasswordsMatch"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:background="@drawable/resource_true"
                                    android:gravity="center"
                                    android:text="✓"
                                    android:textColor="#94A3B8"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvPasswordsMatch"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="9dp"
                                    android:text="Both passwords match"
                                    android:textColor="#64748B"
                                    android:textSize="12sp" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- CREATE ACCOUNT                                    -->
            <!-- ================================================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateAccount"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="Create Account"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#22C55E"
                app:cornerRadius="14dp"
                app:elevation="0dp" />


            <!-- ================================================= -->
            <!-- SECURITY MESSAGE                                  -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#F0FDF4"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#BBF7D0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="13dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_lock"
                        android:contentDescription="Security"
                        app:tint="#22C55E" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="9dp"
                        android:text="Your password helps keep your financial information protected."
                        android:textColor="#4B7A5A"
                        android:textSize="11sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- FOOTER                                           -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:text="SECURED BY EXPENSEVAULT"
                android:textColor="#CBD5E1"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>