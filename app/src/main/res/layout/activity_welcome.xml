<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/ash_background"
    android:overScrollMode="never"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <ImageView
            android:id="@+id/ivExpenseVaultLogo"
            android:layout_width="210dp"
            android:layout_height="126dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_expensevault"
            android:contentDescription="ExpenseVault logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="Track • Plan • Save • Grow"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:letterSpacing="0.03"
            android:gravity="center" />

        <ImageView
            android:id="@+id/ivWelcomeIllustration"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginTop="22dp"
            android:scaleType="centerInside"
            android:src="@drawable/illustration_welcome"
            android:contentDescription="Expense tracking dashboard illustration" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="A Smarter Way to Manage Your Money"
            android:textColor="@color/navy"
            android:textSize="25sp"
            android:textStyle="bold"
            android:fontFamily="sans"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Track your expenses, plan your budget, manage subscriptions and achieve your goals with ExpenseVault."
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignIn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:text="Sign In  →"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:backgroundTint="#159A68"
            app:cornerRadius="18dp"
            app:elevation="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateAccount"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="Create Account"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/navy"
            app:strokeColor="@color/green"
            app:strokeWidth="1dp"
            app:cornerRadius="18dp" />

    </LinearLayout>
</ScrollView>
