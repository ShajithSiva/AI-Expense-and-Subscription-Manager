<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp">


            <!-- ===================================================== -->
            <!-- Logo -->
            <!-- ===================================================== -->

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:src="@drawable/logo"
                android:scaleType="fitCenter"
                android:contentDescription="ExpenseVault Logo" />


            <!-- Brand -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="ExpenseVault"
                android:textColor="#159A68"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />


            <!-- ===================================================== -->
            <!-- Progress -->
            <!-- ===================================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:background="#159A68" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="4dp"
                    android:background="@android:color/transparent" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:background="#E4E9EF" />

            </LinearLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="STEP 1 OF 2"
                android:textColor="#159A68"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />


            <!-- ===================================================== -->
            <!-- Title -->
            <!-- ===================================================== -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="Verify your mobile number"
                android:textColor="#172033"
                android:textSize="27sp"
                android:textStyle="bold" />


            <!-- Subtitle -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="12dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="We'll send a one-time verification code to confirm your phone number and help secure your ExpenseVault account."
                android:textColor="#667085"
                android:textSize="14sp" />


            <!-- ===================================================== -->
            <!-- Phone Number Card -->
            <!-- ===================================================== -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#E4E9EF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">


                    <!-- Label -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MOBILE NUMBER"
                        android:textColor="#667085"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />


                    <!-- Input Container -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_rounded"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="6dp"
                        android:paddingEnd="8dp">


                        <!-- Country Code -->

                        <com.hbb20.CountryCodePicker
                            android:id="@+id/countryCodePicker"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:paddingStart="4dp"
                            android:paddingEnd="2dp"
                            app:ccp_defaultNameCode="LK"
                            app:ccp_showFlag="true"
                            app:ccp_showPhoneCode="true"
                            app:ccp_showNameCode="false"
                            app:ccp_autoDetectCountry="false" />


                        <!-- Divider -->

                        <View
                            android:layout_width="1dp"
                            android:layout_height="28dp"
                            android:background="#CBD5E1" />


                        <!-- Phone -->

                        <EditText
                            android:id="@+id/etPhone"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:hint="77 123 4567"
                            android:inputType="phone"
                            android:maxLength="15"
                            android:paddingStart="14dp"
                            android:paddingEnd="8dp"
                            android:textColor="#172033"
                            android:textColorHint="#98A2B3"
                            android:textSize="16sp" />

                    </LinearLayout>


                    <!-- Helper Text -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="Make sure you have access to this number."
                        android:textColor="#98A2B3"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ===================================================== -->
            <!-- Security Card -->
            <!-- ===================================================== -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#E8F7EF"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="#C5EBD5"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="15dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="#D7F2E2">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_lock_lock"
                            android:contentDescription="Security" />

                    </FrameLayout>


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Secure verification"
                            android:textColor="#146C4A"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Your phone number is used to verify your account."
                            android:textColor="#39745A"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ===================================================== -->
            <!-- Send OTP -->
            <!-- ===================================================== -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendOtp"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:text="Send Verification Code"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#159A68"
                app:cornerRadius="18dp"
                app:elevation="0dp" />


            <!-- ===================================================== -->
            <!-- Login -->
            <!-- ===================================================== -->

            <TextView
                android:id="@+id/tvLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:padding="8dp"
                android:text="Already registered?  Login"
                android:textColor="#667085"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />


            <!-- ===================================================== -->
            <!-- Footer -->
            <!-- ===================================================== -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@android:drawable/ic_lock_lock"
                    android:contentDescription="Secure" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="YOUR SECURITY MATTERS"
                    android:textColor="#98A2B3"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>