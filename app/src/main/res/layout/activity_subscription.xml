<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F4F8F5">
    <com.google.android.material.appbar.AppBarLayout android:id="@+id/appBarLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#FFFFFF" android:elevation="0dp">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="#FFFFFF" app:navigationIcon="@drawable/ic_back_arrow" app:title="Subscriptions" app:titleCentered="false" app:titleTextColor="#173B2A"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/subscriptionScrollView" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginBottom="70dp" android:clipToPadding="false" android:fillViewport="true" app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="110dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="20dp" android:layout_marginEnd="20dp" android:text="Your subscriptions" android:textColor="#173B2A" android:textSize="25sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="4dp" android:layout_marginEnd="20dp" android:text="Track plans, payments and potential savings." android:textColor="#718078" android:textSize="13sp"/>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="18dp" android:layout_marginEnd="16dp" app:cardBackgroundColor="#167C45" app:cardCornerRadius="24dp" app:cardElevation="2dp" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MONTHLY ESTIMATE" android:textColor="#D8F3E2" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.06"/>
                    <TextView android:id="@+id/tvMonthlySpend" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="No subscriptions" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Estimated monthly subscription cost" android:textColor="#D8F3E2" android:textSize="12sp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="20dp" android:layout_marginBottom="18dp" android:background="#5AA77A"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ACTIVE PLANS" android:textColor="#D8F3E2" android:textSize="11sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/tvActiveSubscriptions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="0 Services" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
                        </LinearLayout>
                        <View android:layout_width="1dp" android:layout_height="42dp" android:layout_marginEnd="18dp" android:background="#5AA77A"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NEXT PAYMENT" android:textColor="#D8F3E2" android:textSize="11sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/tvNextDue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="No Due" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!--  AI usage analysis dashboard  -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="24dp" android:layout_marginEnd="20dp" android:text="AI subscription analysis" android:textColor="#173B2A" android:textSize="20sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvAnalysisStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="5dp" android:layout_marginEnd="20dp" android:text="Analyze installed app usage to review subscription value." android:textColor="#718078" android:textSize="12sp"/>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardUsageAnalysis" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="12dp" android:layout_marginEnd="16dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="#E1ECE4" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="#E7F6EC" android:orientation="vertical" android:padding="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="USEFUL" android:textColor="#167C45" android:textSize="10sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/tvUsefulCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="—" android:textColor="#173B2A" android:textSize="24sp" android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="3dp" android:layout_weight="1" android:background="#FFF4D9" android:orientation="vertical" android:padding="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOW USAGE" android:textColor="#946200" android:textSize="10sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/tvLowUsageCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="—" android:textColor="#654A12" android:textSize="24sp" android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:background="#FCE9E7" android:orientation="vertical" android:padding="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UNUSED" android:textColor="#B42318" android:textSize="10sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/tvUnusedCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="—" android:textColor="#8C2119" android:textSize="24sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:id="@+id/tvUsageAnalysisDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Run an analysis to see usage details for your subscriptions." android:textColor="#496455" android:textSize="13sp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnAnalyzeUsage" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="Analyze app usage" android:textAllCaps="false" android:textColor="#FFFFFF" app:backgroundTint="#167C45" app:cornerRadius="13dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardCurrencyRates" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="12dp" android:layout_marginEnd="16dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="#DCEBE0" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="15dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Multi-currency conversion" android:textColor="#173B2A" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvCurrencyRateStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Loading exchange rates..." android:textColor="#718078" android:textSize="11sp"/>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnRefreshCurrencyRates" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="8dp" android:minWidth="0dp" android:text="Refresh" android:textAllCaps="false" android:textSize="12sp" app:backgroundTint="#E8F6EC" app:cornerRadius="10dp" app:icon="@android:drawable/ic_popup_sync" app:iconTint="#167C45" android:textColor="#167C45"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="26dp" android:layout_marginEnd="20dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/tvPlansTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Active plans" android:textColor="#173B2A" android:textSize="20sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Manage your plans" android:textColor="#718078" android:textSize="12sp"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvSubscriptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="12dp" android:layout_marginEnd="16dp" android:clipToPadding="false" android:nestedScrollingEnabled="false"/>
            <LinearLayout android:id="@+id/layoutEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="12dp" android:layout_marginEnd="16dp" android:background="#FFFFFF" android:gravity="center" android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="28dp" android:paddingEnd="24dp" android:paddingBottom="28dp" android:visibility="gone">
                <ImageView android:layout_width="84dp" android:layout_height="84dp" android:contentDescription="No subscriptions" android:src="@drawable/subscribtion"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="No active subscriptions" android:textColor="#173B2A" android:textSize="18sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="Add a subscription manually or analyze your Gmail messages." android:textColor="#718078" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="26dp" android:layout_marginEnd="20dp" android:text="Subscription discovery" android:textColor="#173B2A" android:textSize="20sp" android:textStyle="bold"/>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardGmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="12dp" android:layout_marginEnd="16dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="20dp" app:cardElevation="1dp" app:strokeColor="#E1ECE4" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                    <com.google.android.material.card.MaterialCardView android:layout_width="48dp" android:layout_height="48dp" app:cardBackgroundColor="#E7F6EC" app:cardCornerRadius="15dp" app:cardElevation="0dp" app:strokeWidth="0dp">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:contentDescription="Gmail" android:src="@drawable/ic_email" app:tint="#167C45"/>
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Analyze Gmail" android:textColor="#173B2A" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvGmailStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Detect subscription messages from your email." android:textColor="#718078" android:textSize="12sp"/>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnConnectGmail" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="8dp" android:minWidth="0dp" android:text="Connect" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="13sp" app:backgroundTint="#167C45" app:cornerRadius="12dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnViewDetectedSubscriptions" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginStart="16dp" android:layout_marginTop="10dp" android:layout_marginEnd="16dp" android:text="Review detected subscriptions" android:textAllCaps="false" android:textColor="#167C45" android:textSize="14sp" android:textStyle="bold" android:visibility="gone" app:backgroundTint="#E7F6EC" app:cornerRadius="14dp" app:strokeColor="#B8E1C5" app:strokeWidth="1dp"/>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardUpcomingPayments" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="16dp" android:layout_marginEnd="16dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="#E1ECE4" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                    <com.google.android.material.card.MaterialCardView android:layout_width="44dp" android:layout_height="44dp" app:cardBackgroundColor="#EEF6F0" app:cardCornerRadius="13dp" app:cardElevation="0dp">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:contentDescription="Upcoming payments" android:src="@drawable/ic_calendar" app:tint="#167C45"/>
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Upcoming payments" android:textColor="#173B2A" android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Your next billing date is shown in the summary." android:textColor="#718078" android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardInsight" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="16dp" android:layout_marginEnd="16dp" app:cardBackgroundColor="#E7F6EC" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="#D0EBD8" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:orientation="horizontal" android:padding="16dp">
                    <ImageView android:layout_width="42dp" android:layout_height="42dp" android:contentDescription="AI optimization" android:src="@drawable/income1"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI savings insight" android:textColor="#167C45" android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvOptimization" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Your subscription insights will appear here." android:textColor="#496455" android:textSize="13sp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <Space android:layout_width="match_parent" android:layout_height="28dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fabAddSubscription" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_marginEnd="20dp" android:layout_marginBottom="88dp" android:contentDescription="Add subscription" android:src="@android:drawable/ic_input_add" app:backgroundTint="#167C45" app:borderWidth="0dp" app:elevation="8dp" app:tint="#FFFFFF"/>
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottomNavigation" android:layout_width="match_parent" android:layout_height="70dp" android:layout_gravity="bottom" android:background="#FFFFFF" android:elevation="12dp" app:itemIconTint="@color/bottom_nav_colors" app:itemTextColor="@color/bottom_nav_colors" app:labelVisibilityMode="labeled" app:menu="@menu/bottom_menu"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>